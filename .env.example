# Local development / build environment (no secrets)
#
# Copy to .env only if your tooling loads it before Vite reads vite.config.ts.
# These vars are read at config load time — a single PORT/BASE_PATH pair is not
# enough for the full monorepo build because each Vite artifact uses its own values.
#
# Do not put secrets here. For runtime-only vars (e.g. DATABASE_URL), use a
# separate local .env file and keep it out of git.

# ---------------------------------------------------------------------------
# mockup-sandbox (Component Preview / Canvas)
# Dev:  pnpm --filter @workspace/mockup-sandbox run dev
# Build: see LOCAL build command in replit.md or run with values below
# ---------------------------------------------------------------------------
# PORT=8081
# BASE_PATH=/__mockup

# ---------------------------------------------------------------------------
# supps-timer (main web frontend)
# Dev:  pnpm --filter @workspace/supps-timer run dev
# ---------------------------------------------------------------------------
# PORT=22232
# BASE_PATH=/

# ---------------------------------------------------------------------------
# api-server (Express API — PORT required at runtime, not at build time)
# Dev:  pnpm --filter @workspace/api-server run dev
# ---------------------------------------------------------------------------
# PORT=8080
